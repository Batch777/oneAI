[Unit]
Description=oneAI personal workspace API
After=network.target
[Service]
User=oneai
Group=oneai
WorkingDirectory=/opt/oneai
EnvironmentFile=/etc/oneai/outlook.env
Environment=ONEAI_ENABLE_SESSIONS=1
Environment=ONEAI_APP_ORIGIN=https://47.82.117.21
ExecStart=/opt/oneai/.venv/bin/python -m oneai.web serve
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/oneai
[Install]
WantedBy=multi-user.target
