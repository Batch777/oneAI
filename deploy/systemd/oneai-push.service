[Unit]
Description=oneAI encrypted Web Push outbox delivery
Wants=network-online.target
After=network-online.target
[Service]
Type=oneshot
User=oneai
Group=oneai
WorkingDirectory=/opt/oneai
EnvironmentFile=/etc/oneai/outlook.env
ExecStart=/opt/oneai/.venv/bin/python -m oneai.push run
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/oneai
TimeoutStartSec=120
